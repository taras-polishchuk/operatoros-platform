{
  "name": "operatoros-platform",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local-first Mission execution platform. Operator-controlled runs, durable evidence ledger, and recoverable checkpoints.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.11",
      "markdown-it": "^14.3.3",
      "source-map-js": "^1.2.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "NODE_NO_WARNINGS=1 vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:build": "typedoc --options typedoc.json",
    "contracts:verify": "tsx tooling/verify-authorities.ts",
    "architecture:check": "tsx tooling/check-architecture.ts",
    "spike:persistence": "tsx spikes/persistence/run-matrix.ts",
    "security:scan": "pnpm audit --audit-level high && node tooling/security-scan.mjs",
    "licenses:report": "node tooling/license-report.mjs",
    "sbom": "node tooling/sbom.mjs",
    "demo": "bash scripts/demo.sh",
    "clean-tree:verify": "node tooling/verify-clean-tree.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm contracts:verify && pnpm architecture:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "4.23.15",
    "turbo": "^2.11.3",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taras-polishchuk/operatoros-platform.git"
  },
  "homepage": "https://taras-polishchuk.github.io/operatoros-platform/",
  "bugs": {
    "url": "https://github.com/taras-polishchuk/operatoros-platform/issues"
  }
}
