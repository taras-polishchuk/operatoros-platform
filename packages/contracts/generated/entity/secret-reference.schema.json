{
  "$ref": "#/definitions/entity.secret-reference",
  "definitions": {
    "entity.secret-reference": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "record_version": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "$ref": "#/definitions/entity.secret-reference/properties/created_at"
        },
        "supersedes": {
          "$ref": "#/definitions/entity.secret-reference/properties/entity_id"
        },
        "kind": {
          "type": "string",
          "const": "secret-reference"
        },
        "state": {
          "type": "string",
          "enum": ["declared", "active", "expired", "revoked", "unavailable"]
        },
        "secret_ref": {
          "$ref": "#/definitions/entity.secret-reference/properties/entity_id"
        },
        "backend_id": {
          "$ref": "#/definitions/entity.secret-reference/properties/entity_id"
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "workspace-internal",
            "sensitive",
            "secret-reference",
            "prohibited-secret-value"
          ]
        },
        "allow_purpose": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entity.secret-reference/properties/entity_id"
          },
          "default": []
        },
        "deny_purpose": {
          "$ref": "#/definitions/entity.secret-reference/properties/allow_purpose"
        },
        "rotation_policy": {
          "$ref": "#/definitions/entity.secret-reference/properties/entity_id"
        },
        "expires_at": {
          "$ref": "#/definitions/entity.secret-reference/properties/created_at"
        }
      },
      "required": [
        "entity_id",
        "entity_schema_version",
        "workspace_ref",
        "record_version",
        "created_at",
        "updated_at",
        "kind",
        "state",
        "secret_ref",
        "backend_id",
        "classification"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "entity.secret-reference"
}
