{
  "$ref": "#/definitions/entity.artifact",
  "definitions": {
    "entity.artifact": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "record_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "supersedes": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "artifact"
        },
        "state": {
          "type": "string",
          "enum": ["draft", "validated", "active", "superseded", "archived"]
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1
        },
        "content_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_id",
        "entity_schema_version",
        "workspace_ref",
        "record_version",
        "created_at",
        "updated_at",
        "kind",
        "state",
        "artifact_kind",
        "content_ref"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "entity.artifact"
}
