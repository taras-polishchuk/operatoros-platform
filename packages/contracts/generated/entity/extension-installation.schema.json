{
  "$ref": "#/definitions/entity.extension-installation",
  "definitions": {
    "entity.extension-installation": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "record_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "supersedes": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "extension-installation"
        },
        "state": {
          "type": "string",
          "enum": ["staged", "validated", "active", "suspended", "retired"]
        },
        "extension_id": {
          "type": "string",
          "minLength": 1
        },
        "extension_kind": {
          "type": "string",
          "enum": ["plugin", "integration", "dashboard", "telemetry-exporter", "adapter"]
        },
        "manifest_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host_compatibility": {
          "type": "string",
          "minLength": 1
        },
        "capability_definitions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requested_capabilities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "security_boundary_ref": {
          "type": "string",
          "minLength": 1
        },
        "successor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_id",
        "entity_schema_version",
        "workspace_ref",
        "record_version",
        "created_at",
        "updated_at",
        "kind",
        "state",
        "extension_id",
        "extension_kind",
        "manifest_ref",
        "content_digest",
        "host_compatibility",
        "security_boundary_ref"
      ],
