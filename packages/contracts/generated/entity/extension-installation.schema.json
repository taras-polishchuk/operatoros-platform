{
  "$ref": "#/definitions/entity.extension-installation",
  "definitions": {
    "entity.extension-installation": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "record_version": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "$ref": "#/definitions/entity.extension-installation/properties/created_at"
        },
        "supersedes": {
          "$ref": "#/definitions/entity.extension-installation/properties/entity_id"
        },
        "kind": {
          "type": "string",
          "const": "extension-installation"
        },
        "state": {
          "type": "string",
          "enum": ["staged", "validated", "active", "suspended", "retired"]
        },
        "extension_id": {
          "$ref": "#/definitions/entity.extension-installation/properties/entity_id"
        },
        "extension_kind": {
          "type": "string",
          "enum": ["plugin", "integration", "dashboard", "telemetry-exporter", "adapter"]
        },
        "manifest_ref": {
          "$ref": "#/definitions/entity.extension-installation/properties/entity_id"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host_compatibility": {
          "type": "string",
          "minLength": 1
        },
        "capability_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entity.extension-installation/properties/entity_id"
          },
          "default": []
        },
        "requested_capabilities": {
          "$ref": "#/definitions/entity.extension-installation/properties/capability_definitions"
        },
        "security_boundary_ref": {
          "$ref": "#/definitions/entity.extension-installation/properties/entity_id"
        },
        "successor": {
          "$ref": "#/definitions/entity.extension-installation/properties/entity_id"
        }
      },
      "required": [
        "entity_id",
        "entity_schema_version",
        "workspace_ref",
        "record_version",
        "created_at",
        "updated_at",
        "kind",
        "state",
        "extension_id",
        "extension_kind",
        "manifest_ref",
        "content_digest",
        "host_compatibility",
        "security_boundary_ref"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "entity.extension-installation"
}
