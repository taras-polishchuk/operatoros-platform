{
  "$ref": "#/definitions/entity.operator-profile",
  "definitions": {
    "entity.operator-profile": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "record_version": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "$ref": "#/definitions/entity.operator-profile/properties/created_at"
        },
        "supersedes": {
          "$ref": "#/definitions/entity.operator-profile/properties/entity_id"
        },
        "kind": {
          "type": "string",
          "const": "operator-profile"
        },
        "state": {
          "type": "string",
          "enum": ["draft", "active", "suspended", "archived"]
        },
        "identity_ref": {
          "type": "string",
          "pattern": "^(identity|service|machine):\\/\\/"
        }
