        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "granted_at": {
          "$ref": "#/definitions/entity.capability-grant/properties/created_at"
        },
        "expires_at": {
          "$ref": "#/definitions/entity.capability-grant/properties/created_at"
        },
        "revoker_ref": {
          "$ref": "#/definitions/entity.capability-grant/properties/subject_ref"
        },
        "successor": {
          "$ref": "#/definitions/entity.capability-grant/properties/entity_id"
        }
      },
      "required": [
        "entity_id",
        "entity_schema_version",
        "workspace_ref",
        "record_version",
        "created_at",
        "updated_at",
        "kind",
        "state",
        "grant_id",
        "subject_ref",
        "capability_definition_ref",
        "scope",
        "granted_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "entity.capability-grant"
