          "type": "string",
          "minLength": 1
        },
        "entity_schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "record_version": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "$ref": "#/definitions/entity.capability-grant/properties/created_at"
        },
        "supersedes": {
          "$ref": "#/definitions/entity.capability-grant/properties/entity_id"
        },
        "kind": {
          "type": "string",
          "const": "capability-grant"
        },
        "state": {
          "type": "string",
          "enum": ["draft", "active", "suspended", "revoked"]
        },
        "grant_id": {
          "$ref": "#/definitions/entity.capability-grant/properties/entity_id"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^(identity|service|machine):\\/\\/"
        },
