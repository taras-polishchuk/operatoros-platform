{
  "$ref": "#/definitions/envelope.event",
  "definitions": {
    "envelope.event": {
      "type": "object",
      "properties": {
        "envelope_id": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "run_ref": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "stream_topic": {
          "type": "string",
          "minLength": 1
        },
        "subject_identity_ref": {
          "type": "string",
          "pattern": "^(identity|service|machine):\\/\\/"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "classification": {
          "default": "workspace-internal",
          "type": "string",
          "enum": [
            "public",
            "workspace-internal",
            "sensitive",
            "secret-reference",
            "prohibited-secret-value"
          ]
        }
      },
      "required": [
        "envelope_id",
        "command_id",
        "observed_at",
        "stream_topic",
        "subject_identity_ref",
        "workspace_ref",
        "payload"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "envelope.event"
}
