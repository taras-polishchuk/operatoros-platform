{
  "$ref": "#/definitions/envelope.command",
  "definitions": {
    "envelope.command": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "request_key": {
          "type": "string",
          "minLength": 1
        },
        "command_type": {
          "type": "string",
          "minLength": 1
        },
        "subject_identity_ref": {
          "type": "string",
          "pattern": "^(identity|service|machine):\\/\\/"
        },
        "operator_profile_ref": {
          "type": "string",
          "pattern": "^(identity|service|machine):\\/\\/"
        },
        "capability_grant_ref": {
          "type": "string",
          "pattern": "^(identity|service|machine):\\/\\/"
        },
        "workspace_ref": {
          "type": "string",
          "pattern": "^workspace[_:/-]"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload_schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "causation_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "classification": {
          "default": "workspace-internal",
          "type": "string",
          "enum": [
            "public",
            "workspace-internal",
            "sensitive",
            "secret-reference",
            "prohibited-secret-value"
          ]
        }
      },
      "required": [
        "command_id",
        "request_key",
        "command_type",
        "subject_identity_ref",
        "workspace_ref",
        "payload_schema_version",
        "payload",
        "correlation_id",
        "requested_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "envelope.command"
}
